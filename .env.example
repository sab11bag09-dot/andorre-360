# Base SQLite locale ou chemin absolu vers un volume persistant.
DATABASE_URL="file:./dev.db"

# Obligatoire en production pour Auth.js. Générer une valeur aléatoire forte.
AUTH_SECRET="replace-with-a-random-secret"

# Origine publique sans barre oblique finale, utilisée par canonical et hreflang.
NEXT_PUBLIC_SITE_URL="https://example.com"

# Coupe-circuit : la publication reste interdite tant que la valeur n'est pas true.
MULTILINGUAL_PUBLICATION_ENABLED="false"

# Publication automatique : désactivée par défaut.
AI_AUTO_PUBLICATION_ENABLED="false"
# Arrêt d'urgence prioritaire.
AI_AUTO_PUBLICATION_EMERGENCY_STOP="false"
# Pilote FC Andorra (sourceId 54), uniquement si AUTO est explicitement activé.
AI_AUTO_PUBLICATION_SOURCE_IDS="54"

# Requis uniquement pour générer de nouvelles traductions avec OpenAI.
OPENAI_API_KEY=""
OPENAI_TRANSLATION_MODEL="gpt-5.6-terra"

# Protège l'endpoint de collecte planifiée des sources.
SOURCE_COLLECTION_SECRET="replace-with-a-random-secret"

# Nombre maximal de sources traitées par déclenchement (1 à 50).
SOURCE_COLLECTION_BATCH_SIZE="10"

# Requis uniquement lors de la création initiale d'un administrateur.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME=""
ADMIN_LAST_NAME=""

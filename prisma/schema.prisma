generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Article {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String
  category      String
  description   String
  content       String
  image         String
  author        String
  readingTime   String
  contentType   String   @default("article")
  videoUrl      String?
  videoDuration String?
  socialText    String?
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  publications Publication[]
  analytics    ArticleAnalytics[]
}

model Media {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String
  path         String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  caption      String?
  createdAt    DateTime @default(now())
}

model Edition {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publications Publication[]
}

model Publication {
  id        Int     @id @default(autoincrement())
  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  editionId Int?
  edition   Edition? @relation(fields: [editionId], references: [id])

  channel  String
  pageKey  String @default("home")
  zone     String
  priority Int    @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  analytics PublicationAnalytics[]
}

model ArticleAnalytics {
  id        Int     @id @default(autoincrement())
  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  date             DateTime
  views            Int      @default(0)
  uniqueVisitors   Int      @default(0)
  totalReadingTime Int      @default(0)
  completedReads   Int      @default(0)

  @@unique([articleId, date])
}

model PublicationAnalytics {
  id            Int         @id @default(autoincrement())
  publicationId Int
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  impressions Int @default(0)
  clicks      Int @default(0)
  shares      Int @default(0)
}

model Source {
  id Int @id @default(autoincrement())

  // Identité
  name             String
  description      String?
  url              String  @unique
  organizationType String  @default("OTHER")

  // Collecte
  collectionMode       String  @default("RSS")
  checkIntervalMinutes Int     @default(15)
  active               Boolean @default(true)

  // Politique éditoriale
  publicationMode String  @default("MANUAL")
  trustLevel      String  @default("HIGH")
  category        String?

  // État du collecteur
  lastCheckedAt    DateTime?
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
